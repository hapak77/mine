# ==========================================
# КОНФИГУРАЦИЯ TELEGRAM-БОТА «ПДД БЕЗ ЗУБРЕЖКИ»
# ==========================================

# 1. Telegram Bot API
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_your_bot_token
# Список ID администраторов через запятую
ADMIN_IDS=123456789,987654321
# ID приватного чата/канала для отправки CRITICAL/ERROR логов
ADMIN_CHAT_ID=-1001234567890

# 2. Режим работы (webhook или polling)
# Для разработки можно ставить polling, для продакшна - webhook
USE_WEBHOOK=false
WEBHOOK_DOMAIN=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_super_secret_webhook_token_32chars
WEBHOOK_PORT=8080

# 3. База данных PostgreSQL
POSTGRES_USER=pdd_user
POSTGRES_PASSWORD=pdd_secure_password
POSTGRES_DB=pdd_database
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 4. Redis (FSM и кэширование)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# 5. Платежные шлюзы (ЮKassa / Robokassa / Stars)
# Если используешь Telegram Stars, токен шлюза не нужен
PAYMENT_PROVIDER_TOKEN=381764678:TEST:12345
ENABLE_TELEGRAM_STARS=true

# 6. Файлы и лид-магнит
LEAD_MAGNET_PATH=data/master_pdd_guide.pdf
QUESTIONS_DATA_PATH=data/parsed_tickets.json

# 7. Медиа-кружки инструктора (file_id в Telegram)
# Получи file_id после отправки видео-кружка боту
WELCOME_VIDEO_NOTE_ID=
DEMO_FAIL_VIDEO_NOTE_ID=
