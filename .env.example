# Telegram
BOT_TOKEN=123456:ABC-DEF
ADMIN_ID=123456789

# Партнёрская ссылка 1win (к ней автоматически добавится &sub1=CLICK_ID)
LANDING_URL=https://r1wtvmb.life/casino/list?open=register&p=fiyw

# Публичный HTTPS URL сервера БЕЗ /postback (обязательно, не localhost)
# Пример: https://bot.example.com
PUBLIC_BASE_URL=https://YOUR-DOMAIN.COM

# Секрет postback (если 1win позволяет добавить static-параметр)
# Если пусто — проверка secret отключена
POSTBACK_SECRET=change_me_secret

# Имена параметров postback (легко менять под реальный формат 1win)
POSTBACK_CLICK_ID_PARAM=click_id
POSTBACK_EVENT_PARAM=event
POSTBACK_SECRET_PARAM=secret
# Событие регистрации (НЕ deposit / revenue)
POSTBACK_SUCCESS_EVENT=registration

# Опционально: whitelist IP 1win через запятую. Пусто = не проверять
POSTBACK_ALLOWED_IPS=

# HTTP сервер (локальный bind; снаружи нужен reverse-proxy на PUBLIC_BASE_URL)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Задержка уведомления пользователю после postback (секунды)
ACTIVATION_NOTIFICATION_DELAY=120

# Время жизни прогноза (секунды)
SIGNAL_LIFETIME=240

# Уведомления админу
ADMIN_NOTIFY_ON_NEW_USER=true
ADMIN_NOTIFY_ON_ACTIVATION=true
ADMIN_NOTIFY_ON_SIGNAL=false
