# Telegram
BOT_TOKEN=123456:ABC-DEF
ADMIN_ID=123456789

# Landing / прокладка (click_id подставится как ?subid=...)
LANDING_URL=https://example.com/landing

# Справочно: URL postback, который вы укажете в партнёрке
# Пример: https://YOUR_SERVER:8080/postback
POSTBACK_URL=https://YOUR_SERVER:8080/postback

# Безопасность postback
POSTBACK_SECRET=change_me_secret
# Какой status/event считать успешной регистрацией
POSTBACK_SUCCESS_STATUS=reg
# Опционально: список IP через запятую. Пусто = не проверять
POSTBACK_ALLOWED_IPS=

# HTTP сервер postback
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Задержка уведомления пользователю после postback (секунды)
ACTIVATION_NOTIFICATION_DELAY=120

# Время жизни прогноза (секунды)
SIGNAL_LIFETIME=240

# Уведомлять админа о каждом прогнозе
ADMIN_NOTIFY_ON_SIGNAL=false
