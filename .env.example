# Telegram
BOT_TOKEN=123456:ABC-DEF
ADMIN_ID=123456789

# Ваша реферальная ссылка 1win (кнопка ведёт сразу сюда)
# Бот сам добавит &sub1=УНИКАЛЬНЫЙ_КОД
REFERRAL_URL=https://r1wtvmb.life/casino/list?open=register&p=fiyw

# ===== ВАЖНО: адрес вашего VPS для postback =====
# Можно БЕЗ домена — просто публичный IP + порт:
#   PUBLIC_BASE_URL=http://1.2.3.4:8080
# Подставьте СВОЙ IP VPS (тот, по которому заходите на сервер)
PUBLIC_BASE_URL=http://YOUR_VPS_IP:8080

# Разрешить http://IP:порт без покупки домена (по умолчанию true)
ALLOW_HTTP_IP=true

# Любой пароль, который сами придумаете (тот же впишете в кабинет 1win)
POSTBACK_SECRET=change_me_secret

# Имена параметров postback (менять только если формат 1win другой)
POSTBACK_CLICK_ID_PARAM=click_id
POSTBACK_EVENT_PARAM=event
POSTBACK_SECRET_PARAM=secret
POSTBACK_SUCCESS_EVENT=registration

# Опционально: IP 1win через запятую. Пусто = не проверять
POSTBACK_ALLOWED_IPS=

# На каком порту слушать postback на VPS (должен совпадать с портом в PUBLIC_BASE_URL)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Задержка уведомления пользователю после postback (секунды)
ACTIVATION_NOTIFICATION_DELAY=120

# Время жизни прогноза (секунды)
SIGNAL_LIFETIME=240

# Уведомления админу
ADMIN_NOTIFY_ON_NEW_USER=true
ADMIN_NOTIFY_ON_ACTIVATION=true
ADMIN_NOTIFY_ON_SIGNAL=false

# ===== ТЕСТ БЕЗ РЕГИСТРАЦИИ =====
# true  = на Mac можете сразу жать «Получить прогноз» без 1win
# false = боевой режим (нужен postback)
# Админ (ADMIN_ID) и так всегда имеет доступ + команда /unlock
DEV_SKIP_ACTIVATION=true
